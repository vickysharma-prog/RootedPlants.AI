# copy to .env.local and fill in. .env.local is never committed.

# only needed to re-run the media fetchers in tools/. The app itself needs
# no key: the weather API is open and every check runs in the browser.
PEXELS_API_KEY=

# optional. Without it the add-plant flow skips identification and the
# species picker works as it always has.
PLANTNET_API_KEY=

# Reminders. Each is optional: without its keys that channel reports itself as
# not connected rather than failing quietly.
RESEND_API_KEY=
RESEND_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# The hourly clock needs somewhere to look. Upstash over REST, two variables,
# no client library. Vercel's own KV names work too.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Stops anybody but the cron making somebody's phone buzz.
CRON_SECRET=
