# copy to .env.local and fill in. .env.local is never committed.

# only needed to re-run the media fetchers in tools/. The app itself needs
# no key: the weather API is open and every check runs in the browser.
PEXELS_API_KEY=

# optional. Without it the add-plant flow skips identification and the
# species picker works as it always has.
PLANTNET_API_KEY=
